# Experiment artifacts (tables/summaries/figures stay tracked)
# models/: track docs/checksums only; ignore all weights and run sidecars
models/**
!models/README.md
!models/v4/
!models/v4/fa_hppo/
!models/v4/fa_hppo/CHECKSUMS.json
models/**/*.pt
results/raw/
results/runs/
results/smoke/raw/
results/smoke/runs/
results/v1/pilot/**/*.pt
results/v3/*.log
results/v3/generate_test.log
results/v3/evaluate_test.log
results/v3/build_artifacts.log
results/v3/ablation_*.log
results/v3/development/**/*.pt

# FRVCP download cache (XML/JSON under benchmark/ are tracked)
data/external/frvcpy/benchmark/zips/

# Generated dataset metadata. data/raw stays tracked and immutable.
data/processed/*
!data/processed/.gitkeep
data/routes/*
!data/routes/.gitkeep
!data/routes/corpus.jsonl
!data/routes/manifest.csv
!data/routes/corpus_metadata.json
